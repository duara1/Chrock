<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/borda_card">

    <TextView
        android:id="@+id/nomeTransferencia"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        tools:text="Fulano Duarte"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end"
        />

    <TextView
        android:id="@+id/transferiu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Transferiu: 0,00"
        app:layout_constraintTop_toBottomOf="@id/nomeTransferencia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/despesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="De: Despesa"
        app:layout_constraintTop_toBottomOf="@id/transferiu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <Button
        android:id="@+id/confirmar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar"
        app:layout_constraintTop_toBottomOf="@id/despesa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/contestar"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#61B54B"
        app:rippleColor="#20FFFFFF"
        android:paddingHorizontal="10dp"/>

    <Button
        android:id="@+id/contestar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Contestar"
        app:layout_constraintTop_toBottomOf="@id/despesa"
        app:layout_constraintStart_toEndOf="@id/confirmar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"
        android:backgroundTint="@color/white"
        app:strokeWidth="2dp"
        app:strokeColor="@color/roxoEscrita"
        android:textColor="@color/roxoEscrita"
        app:rippleColor="#207467CA"
        android:paddingHorizontal="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>