<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:background="@drawable/borda_card"
    android:padding="10dp"
    android:layout_marginEnd="10dp">

    <TextView
        android:id="@+id/nomeDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Internet"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/para"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Para: Beltrano Duarte"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/nomeDespesa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/bola"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="3dp"
        tools:srcCompat="@drawable/bola_amarela"
        app:layout_constraintTop_toTopOf="@id/venceEm"
        app:layout_constraintEnd_toStartOf="@id/venceEm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/venceEm"
        android:visibility="gone"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/venceEm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Vence em 15 dias"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/para"
        app:layout_constraintStart_toEndOf="@id/bola"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/voceTransfere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Você transfere:"
        android:layout_marginTop="15dp"
        android:textSize="15sp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/venceEm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="00,00"
        android:textSize="15sp"
        android:gravity="center"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/voceTransfere"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/pix"
        android:layout_width="15dp"
        android:layout_height="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/status"
        app:layout_constraintEnd_toStartOf="@id/status"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/status"
        app:srcCompat="@drawable/pix" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Pendente"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/valor"
        app:layout_constraintStart_toEndOf="@id/pix"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>