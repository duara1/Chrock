<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/historico"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".historico">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="Histórico"
        android:textColor="#252525"
        android:textSize="26sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />

    <Spinner
        android:id="@+id/modoHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:contentDescription="Escolher entre meu histórico e o histórico da sala" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/conteudoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/fundoClaro"
        android:paddingTop="10dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/abaInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            app:drawableTopCompat="@drawable/inicio"
            app:drawableTint="@color/black"
            android:text="Início"
            android:gravity="center"
            android:stateListAnimator="@drawable/anima"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/abaHistorico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            app:drawableTopCompat="@drawable/historico"
            app:drawableTint="@color/roxoEscrita"
            android:text="Histórico"
            android:contentDescription="Histórico, tela atual"
            android:gravity="center"
            android:stateListAnimator="@drawable/anima"
            android:textColor="@color/black"
            android:textSize="13sp" />


    </LinearLayout>

</LinearLayout>