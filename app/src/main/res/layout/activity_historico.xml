<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Histórico" android:textStyle="bold" android:textSize="26sp"
        android:padding="20dp" android:textColor="#252525" />
    <Spinner android:id="@+id/modoHistorico" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="12dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/conteudoHistorico" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="12dp" android:orientation="vertical" />
    </ScrollView>
    <TextView android:id="@+id/abaInicio" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center" android:text="Voltar para sala"
        android:background="#F0EDF8" android:textColor="#423270" android:clickable="true" />
</LinearLayout>
