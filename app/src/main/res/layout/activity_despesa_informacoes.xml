<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/despesaInformacoes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".despesa_informacoes"
    android:background="@color/white">

    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/onda_superior"
        android:importantForAccessibility="no"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/onda_inferior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintWidth_percent="0.75" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/retangulo_superior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.88"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.80" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/retangulo_superior"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.88"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.80">

        <TextView
            android:id="@+id/tituloDespesa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Internet"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subTituloDespesa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Total: 120,00"
            android:maxLines="1"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tituloDespesa" />

        <TextView
            android:id="@+id/responsavel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Responsável:"
            android:layout_marginTop="25dp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toStartOf="@id/vencimento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subTituloDespesa" />

        <TextView
            android:id="@+id/vencimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Vencimento:"
            android:paddingHorizontal="5dp"
            android:layout_marginTop="25dp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subTituloDespesa"
            app:layout_constraintStart_toEndOf="@id/responsavel"/>

        <TextView
            android:id="@+id/nomeResponsavel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/black"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/dataVencimento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/responsavel"
            tools:text="Beltrano Duarte" />

        <TextView
            android:id="@+id/dataVencimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="5dp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vencimento"
            tools:text="00/00/0000"
            app:layout_constraintStart_toEndOf="@id/nomeResponsavel"/>

        <TextView
            android:id="@+id/valorTransferir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Valor a transferir:"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@+id/btnPix"
            app:layout_constraintEnd_toStartOf="@+id/btnPix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnPix" />

        <Button
            android:id="@+id/btnPix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Copiar pix"
            android:paddingHorizontal="8dp"
            android:textSize="14sp"
            android:backgroundTint="@color/roxoBtn"
            app:rippleColor="#20FFFFFF"
            android:textColor="@color/white"
            android:layout_marginTop="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/valorTransferir"
            app:layout_constraintTop_toBottomOf="@+id/dataVencimento" />

        <TextView
            android:id="@+id/valor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/black"
            android:text="00,00"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/valorTransferir"
            app:layout_constraintWidth_percent="0.45"/>

        <TextView
            android:id="@+id/contribuentes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quem contribui:"
            android:layout_marginTop="25dp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/valor" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaContribuentes"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/sinalizar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contribuentes"
            tools:listitem="@layout/item_contribuentes" />

        <Button
            android:id="@+id/sinalizar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="13dp"
            android:text="Sinalizar transferencia"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/listaContribuentes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="@color/cinza"
            android:textColor="@color/black"
            app:rippleColor="#207467CA"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>