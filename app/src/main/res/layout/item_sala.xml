<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSala"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/gray_card_bg"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Foto da sala. Enquanto não houver imagem, aparece o fundo cinza -->
        <ImageView
            android:id="@+id/imgSala"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/gray_text_hint"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Casa" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/black_text"
            android:textSize="12sp"
            tools:text="Divisão das principais contas do apê." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
