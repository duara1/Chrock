<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- halo cinza -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#F2F2F2" />
        </shape>
    </item>
    <!-- círculo interno -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#F5F5F5" />
            <stroke android:width="1.5dp" android:color="#7466CC" />
        </shape>
    </item>
</layer-list>
